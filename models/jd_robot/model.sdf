<?xml version="1.0"?>

<sdf version="1.10">

  <model name="jd_robot">

    <pose>0 0 0.15 0 0 0</pose>

    <!-- MAIN BODY -->

    <link name="base_link">

      <gravity>false</gravity>

      <inertial>
        <mass>12.0</mass>
        <inertia>
          <ixx>0.25</ixx>
          <iyy>0.25</iyy>
          <izz>0.20</izz>
        </inertia>
      </inertial>

      <collision name="base_collision">
        <geometry>
          <cylinder>
            <radius>0.30</radius>
            <length>0.30</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="base_visual">
        <geometry>
          <cylinder>
            <radius>0.30</radius>
            <length>0.30</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.75 0.75 0.78 1</ambient>
          <diffuse>0.75 0.75 0.78 1</diffuse>
        </material>
      </visual>

    </link>


    <!-- HEAD / SENSOR HOUSING -->

    <link name="head">

      <pose>0 0 0.38 0 0 0</pose>

      <inertial>
        <mass>3.0</mass>
        <inertia>
          <ixx>0.05</ixx>
          <iyy>0.05</iyy>
          <izz>0.05</izz>
        </inertia>
      </inertial>

      <collision name="head_collision">
        <geometry>
          <box>
            <size>0.38 0.30 0.18</size>
          </box>
        </geometry>
      </collision>

      <visual name="head_visual">
        <geometry>
          <box>
            <size>0.38 0.30 0.18</size>
          </box>
        </geometry>

        <material>
          <ambient>0.20 0.20 0.22 1</ambient>
          <diffuse>0.20 0.20 0.22 1</diffuse>
        </material>
      </visual>
          <!-- 2D LIDAR -->

      <sensor name="lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>10</update_rate>

        <topic>/scan</topic>
       

        <pose>0 0 0.10 0 0 0</pose>

        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>

          <range>
            <min>0.12</min>
            <max>8.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>

    <!-- IMU -->
      <sensor name="imu" type="imu">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <visualize>false</visualize>
        <topic>/imu</topic>
      </sensor>
    </link>


    <!-- HEAD JOINT -->

    <joint name="head_joint" type="fixed">
      <parent>base_link</parent>
      <child>head</child>
    </joint>


    <!-- MOVEMENT -->

    <plugin
      filename="gz-sim-velocity-control-system"
      name="gz::sim::systems::VelocityControl">
      <topic>/cmd_vel</topic>
    </plugin>
    
    <!-- Odometry publisher -->
    
    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">

      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <dimensions>2</dimensions>

    </plugin>
  </model>

</sdf>